[Unit]
Description=APOLO VPS Environment Provider Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=apolo
Group=apolo
WorkingDirectory=/opt/apolo-vps/backend
EnvironmentFile=/etc/apolo-vps/apolo-vps.env
ExecStart=/opt/apolo-vps/venv/bin/python -m apolo_vps.environment_worker
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/apolo-vps
ProtectHome=true

[Install]
WantedBy=multi-user.target
