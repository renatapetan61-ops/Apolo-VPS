{
  "name": "APOLO VPS - QEMU development environment",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "64gb"
  },
  "remoteUser": "vscode",
  "postCreateCommand": "bash scripts/codespaces-hypervisor-preflight.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
