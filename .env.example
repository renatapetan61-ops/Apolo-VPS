# API control plane (store in your API host's secret manager)
APOLO_CORS_ORIGINS=https://YOUR-DASHBOARD-DOMAIN
APOLO_CONTROL_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET
APOLO_PROVISIONER_URL=https://PRIVATE-HOST-AGENT-ENDPOINT
APOLO_PROVISIONER_TOKEN=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
APOLO_STATE_DB=/var/lib/apolo-vps/state.sqlite3
APOLO_ENABLED_PROVIDERS=libvirt-agent
APOLO_WORKER_POLL_SECONDS=10
APOLO_ALLOW_INSECURE_AGENT=false

# Worker storage contract: implemented by the private host agent/storage adapter.
# It must return durable=true and a persistent disk_uri from /agent/v1/disks/ensure.
# It must implement /agent/v1/capacity, /agent/v1/environments/restore,
# and /agent/v1/runtimes/{runtime_id} with independent runtime verification.

# Host-agent environment (on the KVM hypervisor)
APOLO_AGENT_TOKEN=REPLACE_WITH_THE_SAME_PROVISIONER_TOKEN
APOLO_LIBVIRT_URI=qemu:///system
APOLO_LIBVIRT_BRIDGE=br-apolo
APOLO_VM_STORAGE=/var/lib/libvirt/images/apolo-vps
APOLO_HYPERVISOR_LOCATION=sa-east
APOLO_IMAGE_UBUNTU_2404=/var/lib/libvirt/images/ubuntu-24.04-server-cloudimg-amd64.img
APOLO_IMAGE_DEBIAN_12=/var/lib/libvirt/images/debian-12-generic-amd64.qcow2
APOLO_IMAGE_ROCKY_9=/var/lib/libvirt/images/rocky-9-genericcloud.qcow2
APOLO_IMAGE_WINDOWS_2022=/var/lib/libvirt/images/windows-server-2022.qcow2
APOLO_WINDOWS_TEMPLATE=/etc/apolo-vps/windows-unattend.iso

# Only use networks and gateways explicitly delegated by your network provider.
APOLO_IPV4_CIDR=REPLACE_WITH_PROVIDER_ASSIGNED_IPV4_CIDR
APOLO_IPV6_CIDR=REPLACE_WITH_PROVIDER_ASSIGNED_IPV6_CIDR
APOLO_IPV4_GATEWAY=REPLACE_WITH_IPV4_GATEWAY
APOLO_IPV6_GATEWAY=REPLACE_WITH_IPV6_GATEWAY
APOLO_GUEST_IPV4_PREFIX=32
APOLO_GUEST_IPV6_PREFIX=128
APOLO_DNS_SERVERS=1.1.1.1,2606:4700:4700::1111
